# LAN dev-server access (optional) — used by next.config.ts's
# `allowedDevOrigins` so phones/tablets on the same network can reach the
# dev server via HMR/RSC without Next.js blocking the cross-origin request.
# Not used by `next build`/`next start` — dev-server only.
#
# Copy this file to .env.local and fill in real values there (.env.local is
# gitignored — never commit real IPs/hostnames for your machine here).
LAN_DEV_HOST=Mac-mini-cua-Hoang.local
LAN_DEV_IP=

# SEO release readiness (P2.9) — read by `src/lib/seo.ts`, `src/app/robots.ts`,
# and `src/app/sitemap.ts`. Used at build time (`next build`), not dev-server
# only, so set these in the actual deployment environment, not just locally.
#
# NEXT_PUBLIC_SITE_ENV: "staging" (default if unset) or "production".
#   staging    -> every route noindex, robots.txt is `Disallow: /` (current
#                 state of this branch — do not change without a real
#                 launch decision).
#   production -> public routes become indexable; /reference/*, /tai-khoan,
#                 /thanh-toan, /thu-vien-hinh-anh, /thu-vien-noi-dung stay
#                 noindex regardless of this value.
NEXT_PUBLIC_SITE_ENV=staging

# NEXT_PUBLIC_SITE_URL: the confirmed production origin (e.g.
# https://hoangha.example.vn), no trailing slash. Only used when
# NEXT_PUBLIC_SITE_ENV=production — sitemap.xml is empty and robots.txt
# omits the `Sitemap:` line until this is set to a real, confirmed domain.
# Never hard-code a domain in source; this env var is the only source of it.
NEXT_PUBLIC_SITE_URL=
